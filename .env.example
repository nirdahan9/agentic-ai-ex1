# Copy to .env and set both API keys. Never commit .env.
# OPENAI_API_KEY    — Actor (answer generator), OpenAI
# ANTHROPIC_API_KEY — Evaluator (Critic), Anthropic Claude
# The other variables are optional: when they are left empty, the defaults in chat/config.py
# are used, and those defaults are the settings used in the experiments (see README).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ACTOR_MODEL=
EVALUATOR_MODEL=
PERSON_NAME=
